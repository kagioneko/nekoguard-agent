# NekoGuard Agent - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Mode summary:
#   Demo mode   → no keys needed (mock responses + fixture data)
#   Real mode   → set GEMINI_API_KEY or GOOGLE_CLOUD_PROJECT
#   Dynatrace   → set DYNATRACE_TENANT_URL + DYNATRACE_API_TOKEN

# ============================================================
# LLM: Choose ONE of the two options below
# ============================================================

# Option A: Gemini API Key (simpler, from Google AI Studio)
# Get yours: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: Vertex AI (Google Cloud project)
# Requires: gcloud auth application-default login
# If GEMINI_API_KEY is set, this is ignored.
GOOGLE_CLOUD_PROJECT=nekoguard-agent
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================
# Dynatrace (Partner MCP — required for Dynatrace mode)
# Start a free trial: https://www.dynatrace.com/trial/
# ============================================================
DYNATRACE_TENANT_URL=https://xxxxxxxx.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Security reminder
# ============================================================
# .env is already in .gitignore — never commit real keys.
